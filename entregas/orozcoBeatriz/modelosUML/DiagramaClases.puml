@startuml DiagramaClases
title Cafetería — Diagrama de Clases

class Presupuesto {
    periodoDeTiempo
    costoTotal
}

class Proveedor {
    nombre
    telefono
    direccion
    productos
}

class Inventario {
    productos
}

class Receta {
    nombre
    listaIngredientes
    tiempoPreparacion
    pasos
}

class Menu {
    comida
    precio
}

Presupuesto *-- Proveedor : paga
Proveedor *-- Inventario : suministra
Inventario *--  Receta : proporciona ingredientes a
Receta *--  Menu : crea
Menu *-- Presupuesto : se ajusta a
@enduml