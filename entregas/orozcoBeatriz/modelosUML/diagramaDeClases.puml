@startuml diagramaDeClases
title Diagrama de Clases - Gestión de Base de Datos

skinparam classAttributeIconSize 0
skinparam shadowing false

class Tabla {
  -idTabla: int
  -nombre: String
  -numFilas: int
}

class Campo {
  -idCampo: int
  -nombre: String
  -longitud: int
  -nulo: Boolean
}

class TipoDeCampo {
  -idTipo: int
  -nombre: String
  -tamano: int
}

class Restriccion {
  -idRestriccion: int
  -tipo: String
  -descripcion: String
}

class Llave {
  -idLlave: int
  -nombre: String
}

class Primaria {
  -esCompuesta: Boolean
}

class Foranea {
  -tablaReferencia: String
  -campoReferencia: String
}

class Disparador {
  -idDisparador: int
  -nombre: String
  -evento: String
  -momento: String
}

class Esquema {
  -idEsquema: int
  -nombre: String
}

class Vista {
  -idVista: int
  -nombre: String
  -definicionSQL: String
}

class Consulta {
  -idConsulta: int
  -sentenciaSQL: String
  -fechaEjecucion: Date
}

class Permiso {
  -idPermiso: int
  -accion: String
  -objeto: String
}

class Rol {
  -idRol: int
  -nombre: String
}

class Usuario {
  -idUsuario: int
  -nombre: String
  -email: String
}

Esquema *-- Tabla : contiene >
Esquema *-- Campo : contiene (relacion añadida) >
Tabla *-- Campo : contiene >
Campo --> Restriccion : tiene >
Restriccion --> TipoDeCampo : es >

Usuario --> Rol : tiene >
Rol --> Permiso : tiene >
Usuario --> Consulta : ejecuta >
Consulta --> Tabla : se ejecuta sobre >
Consulta --> Vista : devuelve >
Permiso --> Vista : aplica a >

Tabla *-- Llave : contiene >
Llave <|-- Primaria
Llave <|-- Foranea

Disparador -l-> Tabla : actúa sobre >

Tabla -[hidden]-> Esquema
Esquema -[hidden]-> Vista
Vista -[hidden]-> Consulta
Consulta -[hidden]-> Rol
Rol -[hidden]-> Usuario

@enduml
