@startuml diagramaObjetosInditex
title Diagrama de Objetos - Base de Datos de Inditex

object "Empleado_RRHH : Usuario" as UserRH {
    rol = "Recursos Humanos"
}
object "Empleado_Tienda : Usuario" as UserTienda {
    rol = "Vendedor"
}

object "Inditex_DB : Bases De Datos" as BD

object "Esquema_Empleados : Esquema" as EsqEmp {
    define = "Tabla_Empleados"
    columnas = "id_empleado PK, nombre NN, apellidos NN, depto, salario"
    reglas = "CHECK salario >= 0"
}
object "Esquema_Stock : Esquema" as EsqStock {
    define = "Tabla_Stock"
    columnas = "sku PK, tienda NN, unidades NN"
    reglas = "CHECK unidades >= 0"
}

object "Tabla_Empleados : Tabla" as TablaEmp {
    columnas = "id_empleado, nombre, apellidos, depto, salario"
    registro = "[101, 'Maria', 'Lopez', 'RRHH', 3200]"
}
object "Tabla_Stock : Tabla" as TablaStock {
    columnas = "sku, tienda, unidades"
    registro = "['ZARA123', 'Santander', 54]"
}

object "Vista_Empleados_RRHH : Vista" as VistaEmp {
    nombre = "vw_empleados_rrhh"
    columnas = "id_empleado, nombre, apellidos, depto, salario"
}
object "Vista_Stock_Tienda : Vista" as VistaStock {
    nombre = "vw_stock_tienda"
    columnas = "sku, tienda, unidades"
}

object "Consulta_Empleados : Consulta" as QryEmp {
    sql = "SELECT * FROM vw_empleados_rrhh"
}
object "Consulta_Stock : Consulta" as QryStock {
    sql = "SELECT * FROM vw_stock_tienda WHERE tienda = 'Santander'"
}

object "Rol_RRHH : Rol" as RolRH {
    nombre = "RRHH"
}
object "Rol_Tienda : Rol" as RolTienda {
    nombre = "Tienda"
}
object "Permiso_Ver_Empleados : Permiso" as PermEmp {
    nombre = "VER_EMPLEADOS"
}
object "Permiso_Ver_Stock : Permiso" as PermStock {
    nombre = "VER_STOCK"
}

TablaEmp --> VistaEmp
TablaStock --> VistaStock

VistaEmp --> QryEmp
VistaStock --> QryStock

UserRH *-- RolRH
UserTienda *-- RolTienda

RolRH *-- PermEmp
RolTienda *-- PermStock

PermEmp ..> VistaEmp
PermStock ..> VistaStock

UserRH --> QryEmp
UserTienda --> QryStock

BD *-- EsqEmp
BD *-- EsqStock
EsqEmp --> TablaEmp
EsqStock --> TablaStock

@enduml
